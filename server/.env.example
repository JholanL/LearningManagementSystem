# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voicelink_lms?retryWrites=true&w=majority

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173
